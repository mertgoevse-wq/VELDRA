<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-build-only override of src/main/AndroidManifest.xml. The Android Gradle Plugin
  merges this into the base manifest for the debug build type only. tools:replace is
  required because usesCleartextTraffic is set explicitly (not merely absent) in the main
  manifest, so a plain override would otherwise conflict rather than win. Release builds
  never see this file; they get the safe usesCleartextTraffic="false" from src/main.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:usesCleartextTraffic="true"
        tools:replace="android:usesCleartextTraffic" />

</manifest>
