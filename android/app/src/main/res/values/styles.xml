<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
    </style>


    <!--
      AndroidX Core SplashScreen contract (androidx.core:core-splashscreen, see app/build.gradle):
      on API 31+ this maps directly onto the platform SplashScreen API; on older API levels the
      library reproduces the same look itself. It reads windowSplashScreenBackground /
      windowSplashScreenAnimatedIcon specifically -NOT android:background, which this theme has
      no window chrome to apply it to and which the platform SplashScreen contract never reads.
      postSplashScreenTheme hands the Activity back to the normal app theme automatically once
      SplashScreen.installSplashScreen(this) (MainActivity.onCreate) dismisses the splash, so
      AppTheme.NoActionBarLaunch never stays applied past the launch moment it's meant for.
    -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/veldra_splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/veldra_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>